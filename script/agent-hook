#!/usr/bin/env ruby
# frozen_string_literal: true

# Sends a task to the Multitasking inbox when Claude Code or Codex finishes a
# turn or needs you.
#
#   Claude Code (~/.claude/settings.json), on Stop and Notification:
#     script/agent-hook claude          # hook JSON arrives on stdin
#
#   Codex (~/.codex/config.toml):
#     notify = ["/path/to/script/agent-hook", "codex"]   # JSON arrives as the last argument
#
# Reads `url=` and `token=` from ~/.config/multitasking/config, or from
# MULTITASKING_URL and MULTITASKING_TOKEN.
#
# Runs on the Ruby 2.6 that ships with macOS, so it needs nothing installed.
# Stdlib only, and it always exits 0: a hook that fails or hangs would get in
# the way of the agent it is meant to be watching.

require "json"
require "net/http"
require "uri"

CONFIG_PATH = File.expand_path("~/.config/multitasking/config")

def config
  file = File.exist?(CONFIG_PATH) ? File.read(CONFIG_PATH) : ""
  values = file.lines.to_h { |line| line.strip.split("=", 2) }.reject { |key, _| key.to_s.empty? }

  {
    url: ENV["MULTITASKING_URL"] || values["url"] || "http://localhost:3000",
    token: ENV["MULTITASKING_TOKEN"] || values["token"]
  }
end

# One line, but all of it: the app shows a title in full, so cutting it here
# only loses the end of what you asked for.
def one_line(text)
  text.to_s.gsub(/\s+/, " ").strip
end

# The opening sentence of a prompt, cut at a word if it is still long. A
# prompt that pastes in a bug report runs to paragraphs, and the task's notes
# already carry it in full.
def summary(text, length = 80)
  text = one_line(text)
  sentence = (text[/\A.+?[.?!](?=\s|\z)/] || text).delete_suffix(".")
  sentence.length > length ? "#{sentence[0, length].sub(/\s+\S*\z/, "")}…" : sentence
end

def project_name(cwd)
  cwd.to_s.empty? ? "somewhere" : File.basename(cwd)
end

# The repository a session ran in, so the app can file the task under its
# project. The main checkout, not the worktree: a worktree's path changes with
# every session, the repository's does not. Nil outside a repository, where
# there is no telling what the folder is.
def repository(cwd)
  return if cwd.to_s.empty? || !Dir.exist?(cwd)

  git_dir = IO.popen([ "git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir" ],
                     err: File::NULL, &:read).strip
  File.dirname(git_dir) if $?.success? && File.basename(git_dir) == ".git"
rescue SystemCallError
  nil
end

# Keeps the line breaks, unlike `one_line`: notes are shown as paragraphs.
def clip(text, length = 500)
  text = text.to_s.strip
  text.length > length ? "#{text[0, length - 1]}…" : text
end

def transcript_entries(transcript_path)
  return [] if transcript_path.to_s.empty? || !File.exist?(transcript_path)

  File.foreach(transcript_path).map { |line| JSON.parse(line) rescue nil }.compact
end

def entry_text(entry)
  content = entry.dig("message", "content")
  content.is_a?(Array) ? content.select { |part| part["type"] == "text" }.map { |part| part["text"] }.join("\n\n") : content.to_s
end

# The first thing you asked for in this session, which is a better task title
# than a session id. Skips the wrappers Claude Code stores around commands.
def first_prompt(entries)
  entries.each do |entry|
    next unless entry["type"] == "user"

    text = entry_text(entry)
    next if text.strip.empty? || text.lstrip.start_with?("<")

    return text
  end
  nil
end

# What Claude said last — usually its summary of the turn. Newer Claude Code
# sends it with the hook; the transcript is the fallback, and may be a line
# behind on Stop, so it is only the fallback.
def last_reply(input, entries)
  sent = input["last_assistant_message"].to_s
  return sent unless sent.strip.empty?

  entries.reverse_each
         .select { |entry| entry["type"] == "assistant" && !entry["isSidechain"] }
         .map { |entry| entry_text(entry) }
         .find { |text| !text.strip.empty? }
end

# Opens the session in the Claude desktop app. Only a session the app started
# has a link: it gives the hook its own `local_` id, which is the one
# claude://code/continue accepts. A session run in a terminal has none.
def claude_link
  id = ENV["CLAUDE_CODE_HOST_SESSION_ID"].to_s
  "claude://code/continue?session=#{id}" if id.match?(/\Alocal_[\w-]+\z/)
end

# Opens the thread in the Codex app — the same link its "Copy link" gives.
def codex_link(thread_id)
  "codex://threads/#{thread_id}" if thread_id.to_s.match?(/\A[\w-]+\z/)
end

def claude_task(input)
  project = project_name(input["cwd"])
  entries = transcript_entries(input["transcript_path"])
  prompt = first_prompt(entries)
  topic = one_line(prompt || "session in #{project}")
  waiting = input["hook_event_name"] == "Notification"

  {
    source: "claude",
    external_id: input["session_id"],
    title: waiting ? "Claude needs you: #{topic}" : "Review Claude: #{topic}",
    url: claude_link,
    directory: repository(input["cwd"]),
    prompt: one_line(prompt),
    notes: notes(input["message"], last_reply(input, entries), prompt, input["cwd"])
  }
end

# What you need to pick the task up without opening the session: why it
# pinged, what the agent last said, what you asked for, and where.
def notes(alert, reply, prompt, cwd)
  [
    (clip(alert, 300) unless alert.to_s.strip.empty?),
    (clip(reply) unless reply.to_s.strip.empty?),
    ("You asked: #{clip(prompt)}" unless prompt.to_s.strip.empty?),
    ("Project: #{cwd}" unless cwd.to_s.empty?)
  ].compact.join("\n\n")
end

# Codex names each new thread by running a hidden turn of its own, and notify
# fires for that one too. Its prompt is Codex's instructions for writing a
# title, not anything you asked for, so it is not a task.
CODEX_TITLE_TURN = /\A\s*You are a helpful assistant\. You will be presented with a user prompt, and your job is to provide a short title/

# A thread Codex started to help with yours. It has its own thread id and fires
# notify like any other, but its work reaches you through the thread that
# started it, so a task for each one would only repeat yours. notify does not
# say which kind it is; the first line of the thread's rollout file does.
def codex_home
  ENV["CODEX_HOME"] || File.expand_path("~/.codex")
end

def codex_subagent?(thread_id)
  return false unless thread_id.to_s.match?(/\A[\w-]+\z/)

  sessions = File.join(codex_home, "sessions")
  rollout = Dir.glob(File.join(sessions, "**", "rollout-*-#{thread_id}.jsonl")).first
  return false if rollout.nil?

  meta = JSON.parse(File.open(rollout, encoding: "UTF-8", &:gets).to_s)["payload"].to_h
  meta["thread_source"] == "subagent" || meta["source"].is_a?(Hash) && meta["source"].key?("subagent")
rescue JSON::ParserError, SystemCallError
  false
end

# The short name Codex gave the thread, as its sidebar shows it. Codex names a
# thread a second or two after it starts, so only a turn quicker than that
# misses it; the next turn's ping puts the name right. A rename adds a line,
# so the last one wins.
def codex_thread_name(thread_id)
  return unless thread_id.to_s.match?(/\A[\w-]+\z/)

  index = File.join(codex_home, "session_index.jsonl")
  return unless File.exist?(index)

  File.foreach(index).select { |line| line.include?(thread_id) }.map { |line| JSON.parse(line) rescue nil }.compact
      .select { |entry| entry["id"] == thread_id }
      .map { |entry| one_line(entry["thread_name"]) }
      .reject(&:empty?).last
rescue SystemCallError
  nil
end

def codex_task(input)
  return unless input["type"] == "agent-turn-complete"
  return if codex_subagent?(input["thread-id"])

  project = project_name(input["cwd"])
  prompt = Array(input["input-messages"]).first
  return if prompt.to_s.match?(CODEX_TITLE_TURN)

  topic = codex_thread_name(input["thread-id"]) || (prompt ? summary(prompt) : "thread in #{project}")

  {
    source: "codex",
    external_id: input["thread-id"] || input["turn-id"],
    title: "Review Codex: #{topic}",
    url: codex_link(input["thread-id"]),
    directory: repository(input["cwd"]),
    prompt: one_line(prompt),
    notes: notes(nil, input["last-assistant-message"], prompt, input["cwd"])
  }
end

def deliver(task, settings)
  uri = URI.join(settings[:url], "/inbox/tasks")
  request = Net::HTTP::Post.new(uri, "Content-Type" => "application/json",
                                     "Authorization" => "Bearer #{settings[:token]}")
  request.body = JSON.generate(task)

  Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 2, read_timeout: 3) do |http|
    http.request(request)
  end
end

begin
  agent = ARGV.first
  settings = config
  exit 0 if settings[:token].to_s.empty?

  task =
    case agent
    when "claude" then claude_task(JSON.parse($stdin.read))
    when "codex" then codex_task(JSON.parse(ARGV.last))
    end

  deliver(task, settings) if task
rescue StandardError => e
  warn "multitasking agent-hook: #{e.class}: #{e.message}" if ENV["MULTITASKING_DEBUG"]
end

exit 0
