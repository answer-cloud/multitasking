<%# Takes a project off your own dashboard, or puts it back. A real button in %>
<%# a real form, so it works without JavaScript. The eye shows where the %>
<%# project stands — open while it is on your list, shut while it is hidden — %>
<%# and the label says what a click does. %>
<% action = hidden ? "Show" : "Hide" %>
<%= button_to project_hiding_path(project), method: hidden ? :delete : :post,
      class: "hiding-toggle__button", form_class: "hiding-toggle",
      aria: { label: "#{action} #{project.name} on your list" }, title: action do %>
  <% if hidden %>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M3 9c2.5 4 5.5 6 9 6s6.5-2 9-6" />
      <path d="M12 15v3.5M7.6 13.9l-1 3.1M16.4 13.9l1 3.1M4.6 11.6l-1.8 2M19.4 11.6l1.8 2" />
    </svg>
  <% else %>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M2.5 14C5 9.5 8.3 7.5 12 7.5s7 2 9.5 6.5c-2.5 4.5-5.8 6.5-9.5 6.5s-7-2-9.5-6.5z" />
      <circle cx="12" cy="14" r="3.6" />
      <circle cx="12" cy="14" r="1.6" class="hiding-toggle__pupil" />
      <path d="M12 7.5V4M7.5 8.8 6.3 5.6M16.5 8.8l1.2-3.2M4.2 11.2l-1.8-2M19.8 11.2l1.8-2" />
    </svg>
  <% end %>
<% end %>
