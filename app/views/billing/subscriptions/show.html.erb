<% content_for :title, "Billing" %>

<%= page_title "Billing", description: "Billing belongs to #{current_team.name}, not to you personally." %>

<nav class="subnav" aria-label="Team">
  <% if policy(current_team).update? %>
    <%= link_to "Settings", edit_team_path(current_team), class: "nav-link" %>
  <% end %>
  <%= link_to "Members", team_members_path(current_team), class: "nav-link" %>
  <%= link_to "Billing", billing_subscription_path, class: "nav-link", "aria-current": "page" %>
</nav>

<div class="split">
  <div class="stack--loose stack">
    <% if @subscription %>
      <section class="panel">
        <div class="panel__header">
          <h2><%= @subscription.plan_name %></h2>
          <%= subscription_badge(@subscription) %>
        </div>

        <dl class="detail-list">
          <dt>Seats billed</dt>
          <dd class="numeric"><%= @subscription.quantity %></dd>
          <dt>Team members</dt>
          <dd class="numeric">
            <%= @seat_count %>
            <% if @seat_count != @subscription.quantity %>
              <span class="badge badge--caution">Syncing</span>
            <% end %>
          </dd>
          <dt>Renews</dt>
          <dd><%= short_date(@subscription.current_period_end) %></dd>
          <% if @subscription.trialing? %>
            <dt>Trial ends</dt>
            <dd><%= short_date(@subscription.trial_ends_at) %></dd>
          <% end %>
        </dl>

        <% if @subscription.past_due? %>
          <div class="alert alert--warning" style="margin-top: var(--space-5);">
            <div class="alert__body">
              The last payment failed. Update the card in the billing portal to
              avoid losing access.
            </div>
          </div>
        <% end %>

        <% if policy(@subscription).portal? %>
          <div class="form-actions">
            <%= button_to "Manage billing", portal_billing_subscription_path,
                  class: "btn btn--primary" %>
          </div>
          <p class="field__hint">
            Cards, invoices, plan changes and cancellation are handled by Stripe.
          </p>
        <% end %>
      </section>
    <% else %>
      <section>
        <div class="empty">
          <p class="empty__title">No subscription yet</p>
          <p>Pick a plan below. You will be billed for <%= pluralize(@seat_count, "seat") %>.</p>
        </div>
      </section>

      <section class="price-grid">
        <% @plans.each do |plan| %>
          <div class="price">
            <p class="price__name"><%= plan.name %></p>
            <p class="price__amount">
              <%= plan.monthly_price %><span class="price__unit"> / seat / <%= plan.interval %></span>
            </p>

            <ul class="price__features">
              <% plan.features.each do |feature| %>
                <li><%= feature %></li>
              <% end %>
            </ul>

            <% if policy(billing_subject_for(current_team)).checkout? %>
              <%= button_to "Subscribe to #{plan.name}",
                    checkout_billing_subscription_path(plan: plan.key),
                    class: "btn #{'btn--primary' if plan.default}" %>
            <% else %>
              <p class="quiet">Only a team owner can start a subscription.</p>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="stack">
    <section class="panel panel--sunken">
      <div class="panel__header"><h2>How seats work</h2></div>
      <p class="muted">
        You are billed per member. Adding someone raises the bill with a
        prorated charge; removing someone lowers it. The count updates
        automatically whenever the roster changes.
      </p>
    </section>
  </aside>
</div>
