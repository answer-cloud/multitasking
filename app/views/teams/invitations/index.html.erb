<% content_for :title, "Invitations" %>

<%= page_title "Invitations", description: "All invitations sent for #{@team.name}." %>

<% if @invitations.any? %>
  <div class="table-wrap">
    <table class="table">
      <thead>
        <tr>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Invited by</th>
          <th class="is-numeric">Sent</th>
        </tr>
      </thead>
      <tbody>
        <% @invitations.each do |invitation| %>
          <tr>
            <td class="table__primary"><%= invitation.email %></td>
            <td><span class="badge badge--quiet"><%= invitation.role %></span></td>
            <td>
              <% if invitation.accepted? %>
                <span class="badge badge--positive">Accepted</span>
              <% elsif invitation.expired? %>
                <span class="badge badge--critical">Expired</span>
              <% else %>
                <span class="badge badge--caution">Pending</span>
              <% end %>
            </td>
            <td class="muted"><%= invitation.invited_by.name %></td>
            <td class="is-numeric quiet"><%= short_date(invitation.created_at) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% else %>
  <div class="empty">
    <p class="empty__title">No invitations yet</p>
    <p><%= link_to "Invite someone from the members page", team_members_path(@team) %>.</p>
  </div>
<% end %>
