<% content_for :title, "Create your account" %>

<div class="auth">
  <div class="auth__panel">
    <h1 class="auth__title">Create your account</h1>
    <p class="auth__subtitle">You will pick a team name next.</p>

    <% if google_sign_in_enabled? %>
      <%= render "users/shared/google_button", label: "Continue with Google" %>
      <p class="auth__divider"><span>or create one with a password</span></p>
    <% end %>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "form" }) do |f| %>
      <%= render "shared/form_errors", record: resource %>

      <div class="field">
        <%= f.label :first_name, class: "field__label" %>
        <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name", class: "input" %>
      </div>

      <div class="field">
        <%= f.label :last_name, class: "field__label" %>
        <%= f.text_field :last_name, autocomplete: "family-name", class: "input" %>
      </div>

      <div class="field">
        <%= f.label :email, class: "field__label" %>
        <%= f.email_field :email, autocomplete: "email", class: "input" %>
      </div>

      <div class="field">
        <%= f.label :password, class: "field__label" %>
        <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
        <p class="field__hint">At least <%= @minimum_password_length %> characters.</p>
      </div>

      <div class="field">
        <%= f.label :password_confirmation, "Confirm password", class: "field__label" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Create account", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth__footer">
      <span>Already have an account?</span>
      <%= link_to "Sign in", new_session_path(resource_name) %>
    </div>
  </div>
</div>
