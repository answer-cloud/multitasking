<% content_for :title, "Reset your password" %>

<div class="auth">
  <div class="auth__panel">
    <h1 class="auth__title">Reset your password</h1>
    <p class="auth__subtitle">
      We will email you a link. If the address is registered, it will arrive
      within a minute.
    </p>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post, class: "form" }) do |f| %>
      <div class="field">
        <%= f.label :email, class: "field__label" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "input" %>
      </div>

      <div class="form-actions">
        <%= f.submit "Send reset link", class: "btn btn--primary btn--block" %>
      </div>
    <% end %>

    <div class="auth__footer">
      <%= link_to "Back to sign in", new_session_path(resource_name) %>
    </div>
  </div>
</div>
