<h1 style="margin:0 0 16px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:22px; font-weight:300; letter-spacing:-0.03em; color:#111111;">
  Reset your password
</h1>

<p style="margin:0 0 16px;">Hello <%= @resource.name %>,</p>

<p style="margin:0 0 16px;">
  Someone asked to reset the password for this account. If it was you, use the
  link below. If it was not, ignore this email — your password will not change.
</p>

<%= render "shared/email_button",
      url: edit_password_url(@resource, reset_password_token: @token),
      label: "Choose a new password" %>

<p style="margin:0; font-size:13px; color:#5a5a58;">
  This link expires in <%= distance_of_time_in_words(Devise.reset_password_within) %>.
</p>
