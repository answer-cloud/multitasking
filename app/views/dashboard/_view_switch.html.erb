<%# Plain links, so the switch works without JavaScript. The choice is %>
<%# remembered; see TaskList#list_view. The links stay on the list you are %>
<%# looking at, which may be a colleague's. %>
<nav class="tabs__list today__views" aria-label="Show the list">
  <%= link_to "By task", url_for(view: "tasks"), class: "tabs__tab", aria: { current: ("page" if view == "tasks") } %>
  <%= link_to "By project", url_for(view: "projects"), class: "tabs__tab", aria: { current: ("page" if view == "projects") } %>
</nav>
