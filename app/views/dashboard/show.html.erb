<% content_for :title, "To do" %>

<%= turbo_stream_from current_team, :tasks %>

<div class="today"
     data-controller="checklist"
     data-checklist-count-value="<%= @done_today.size %>"
     data-action="turbo:before-stream-render@document->checklist#holdStream turbo:submit-end->checklist#settled">
  <%= page_title "To do", eyebrow: today_label,
        description: "#{greeting(Current.user)} #{plate_summary(@tasks.size, @done_today.size)}" %>

  <%= render "tasks/quick_add", task: @new_task %>

  <section class="today__section" aria-label="To do">
    <ul class="checklist" id="tasks" data-checklist-target="list">
      <%= render partial: "tasks/task", collection: @tasks, as: :task %>
    </ul>

    <div class="checklist-empty">
      <p class="checklist-empty__art" aria-hidden="true">✦ ˚ ✧ ˚ ✦</p>
      <p class="checklist-empty__title">Inbox zero.</p>
      <p>Nothing left to tick. Type something above, or go outside.</p>
    </div>
  </section>

  <section class="today__section" aria-labelledby="done_today_heading">
    <div class="today__head">
      <h2 id="done_today_heading">
        Done today
        <span class="today__count numeric" id="jar_count" data-checklist-target="count"><%= @done_today.size %></span>
      </h2>
      <button type="button" class="btn-link today__sound"
              data-checklist-target="sound" data-action="checklist#toggleSound"
              aria-pressed="true">Sound on</button>
    </div>

    <ul class="checklist checklist--done" id="done_today">
      <%= render partial: "tasks/done_task", collection: @done_today, as: :task %>
    </ul>
    <p class="today__empty">Nothing yet. Tick something and it lands here.</p>

    <p class="today__more"><%= link_to "Everything you’ve finished →", tasks_path %></p>
  </section>

  <p class="cheer" data-checklist-target="cheer" role="status" aria-live="polite"></p>
</div>
