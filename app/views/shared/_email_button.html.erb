<%# A link styled as a button, using a table so Outlook renders it. %>
<table role="presentation" cellpadding="0" cellspacing="0" border="0" style="margin:24px 0;">
  <tr>
    <td style="background-color:#111111;">
      <a href="<%= url %>"
         style="display:inline-block; padding:12px 24px; font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif; font-size:14px; font-weight:500; color:#ffffff; text-decoration:none;">
        <%= label %>
      </a>
    </td>
  </tr>
</table>
