<% if record.errors.any? %>
  <div class="form-errors" role="alert">
    <p class="form-errors__title">
      <%= pluralize(record.errors.count, "problem") %> stopped this from being saved:
    </p>
    <ul>
      <% record.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
