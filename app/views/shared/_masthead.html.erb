<header class="masthead">
  <div class="container masthead__inner">
    <%# Signed in, the brand is today's tally; the task streams keep it current. %>
    <% if current_team %>
      <%= link_to dashboard_path, class: "masthead__brand" do %>
        Done <span class="tally numeric" data-done-count><%= current_team.tasks.done_today.count %></span>
      <% end %>
    <% else %>
      <%= link_to app_name, user_signed_in? ? dashboard_path : root_path, class: "masthead__brand" %>
    <% end %>

    <% if Current.user %>
      <%= render "shared/menu" %>
    <% else %>
      <div class="masthead__actions">
        <%= link_to "Pricing", pricing_path, class: "masthead__link" %>
        <%= link_to "Sign in", new_user_session_path, class: "masthead__link" %>
        <%= link_to "Get started", new_user_registration_path, class: "btn btn--sm btn--primary" %>
      </div>
    <% end %>
  </div>
</header>
