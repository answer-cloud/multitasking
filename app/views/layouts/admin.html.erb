<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || "Admin" %> · <%= app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# Platform administration must never be indexed or cached. %>
    <meta name="robots" content="noindex, nofollow">


    <%# Preload the Latin subset. The stylesheet only discovers the font after %>
    <%# it parses @font-face, by which time headings have already painted in %>
    <%# the fallback — this starts the download with the stylesheet instead. %>
    <%= preload_link_tag "lexend-deca-latin.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <div class="admin-bar">
      <div class="container admin-bar__inner">
        <span class="admin-bar__title">Platform admin</span>
        <%= link_to "Overview", admin_root_path, "aria-current": current_page?(admin_root_path) ? "page" : nil %>
        <%= link_to "Users", admin_users_path, "aria-current": controller_name == "users" ? "page" : nil %>
        <%= link_to "Teams", admin_teams_path, "aria-current": controller_name == "teams" ? "page" : nil %>
        <%= link_to "Subscriptions", admin_subscriptions_path, "aria-current": controller_name == "subscriptions" ? "page" : nil %>
        <%= link_to "Jobs", admin_sidekiq_web_path %>
        <%= link_to "Back to app", root_path %>
      </div>
    </div>

    <main class="container section" id="main">
      <%= yield %>
    </main>

    <%= render "shared/flashes" %>
  </body>
</html>
