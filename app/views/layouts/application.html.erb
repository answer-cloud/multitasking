<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title).presence || app_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/time_zone" %>
    <%= render "shared/meta" %>
    <%= yield :head %>

    <%# Preload the Latin subset. The stylesheet only discovers the font after %>
    <%# it parses @font-face, by which time headings have already painted in %>
    <%# the fallback — this starts the download with the stylesheet instead. %>
    <%= preload_link_tag "lexend-deca-latin.woff2", as: "font", type: "font/woff2", crossorigin: "anonymous" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body>
    <%= render "shared/impersonation_banner" %>
    <%= render "shared/masthead" %>

    <main class="container page" id="main">
      <%= yield %>
    </main>

    <%= render "shared/footer" %>

    <%# Fixed overlays are direct children of body. Nesting them inside the %>
    <%# padded .container makes their positioning depend on page layout. %>
    <%= render "shared/flashes" %>
    <%= render "shared/modal" %>
    <%= render "shared/confirm" %>
  </body>
</html>
