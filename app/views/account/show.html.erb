<% content_for :title, "Account" %>

<%= page_title "Account", description: @user.email %>

<div class="split">
  <div class="stack--loose stack">
    <section>
      <h2>Profile</h2>
      <%= form_with model: @user, url: account_path, method: :patch, class: "form",
            style: "margin-top: var(--space-4);" do |f| %>
        <div class="field">
          <%= f.label :first_name, class: "field__label" %>
          <%= f.text_field :first_name, class: "input" %>
        </div>

        <div class="field">
          <%= f.label :last_name, class: "field__label" %>
          <%= f.text_field :last_name, class: "input" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Save profile", class: "btn btn--primary" %>
        </div>
      <% end %>
    </section>

    <hr class="rule">

    <section>
      <h2>Password</h2>
      <%= form_with model: @user, url: account_path, method: :patch, class: "form",
            style: "margin-top: var(--space-4);" do |f| %>
        <div class="field">
          <%= f.label :current_password, class: "field__label" %>
          <%= f.password_field :current_password, autocomplete: "current-password", class: "input" %>
        </div>

        <div class="field">
          <%= f.label :password, "New password", class: "field__label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "input" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, "Confirm new password", class: "field__label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "input" %>
        </div>

        <div class="form-actions">
          <%= f.submit "Change password", class: "btn btn--primary" %>
        </div>
      <% end %>
    </section>

    <% if google_sign_in_enabled? %>
      <hr class="rule">

      <section>
        <h2>Sign in with Google</h2>
        <% if @user.google_connected? %>
          <p class="muted" style="margin-top: var(--space-2);">
            Google is connected. You can sign in with it or with your password.
            Disconnecting leaves the password as the only way in, so it asks for
            it first — if you signed up with Google and never set one, use
            <%= link_to "Forgot your password?", new_user_password_path %> to create one before you disconnect.
          </p>
          <%= form_with url: google_account_path, method: :delete, class: "form",
                style: "margin-top: var(--space-4);" do |f| %>
            <div class="field">
              <%= f.label :current_password, "Your password", class: "field__label" %>
              <%= f.password_field :current_password, autocomplete: "current-password", class: "input" %>
            </div>
            <div class="form-actions">
              <%= f.submit "Disconnect Google", class: "btn" %>
            </div>
          <% end %>
        <% else %>
          <p class="muted" style="margin-top: var(--space-2);">
            Connect a Google account and you can sign in with it instead of a
            password. Your email address here stays as it is.
          </p>
          <div style="margin-top: var(--space-4); max-width: 20rem;">
            <%= render "users/shared/google_button", label: "Connect Google" %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <aside class="stack">
    <section class="panel panel--sunken">
      <div class="panel__header"><h2>Your teams</h2></div>
      <ul class="stack--tight stack">
        <% Current.user.memberships.includes(:team).ordered.each do |membership| %>
          <li class="cluster cluster--between">
            <span><%= membership.team.name %></span>
            <%= role_badge(membership) %>
          </li>
        <% end %>
      </ul>
    </section>

    <section class="panel" style="border-color: var(--critical);">
      <div class="panel__header"><h2>Delete account</h2></div>
      <p class="muted">
        Permanently deletes your account. Teams you solely own with no other
        members are deleted too.
      </p>
      <p style="margin-top: var(--space-4);">
        <%= link_to "Delete my account", confirm_delete_account_path, class: "btn btn--sm btn--danger" %>
      </p>
    </section>
  </aside>
</div>
