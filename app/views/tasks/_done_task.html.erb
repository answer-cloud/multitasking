<%# A finished task, in the jar. Ticking it again puts it back on the list. %>
<li id="<%= dom_id(task, :done) %>" class="checklist__item is-done" data-checklist-item>
  <%= form_with url: task_completion_path(task), method: :delete, class: "checklist__form" do %>
    <button type="submit" class="checkbox" role="checkbox" aria-checked="true"
            aria-label="Not done yet: <%= task.title %>"
            data-action="checklist#uncheck">
      <%= render "tasks/tick" %>
    </button>
  <% end %>

  <div class="checklist__body">
    <%= link_to task.title, task, class: "checklist__title" %>
  </div>
</li>
