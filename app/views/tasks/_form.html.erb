<%# A new task posts as plain HTML: create answers Turbo with a stream for %>
<%# the dashboard's list, and this page has no list to put it in. %>
<%= form_with model: task, format: (:html if task.new_record?), class: "form" do |form| %>
  <%= render "shared/form_errors", record: task %>
  <%= form.hidden_field :source if task.new_record? %>

  <div class="field">
    <%= form.label :title, class: "field__label" %>
    <%= form.text_field :title, class: "input", maxlength: Task::TITLE_LIMIT, required: true,
          "aria-invalid": task.errors.include?(:title) %>
  </div>

  <div class="field">
    <%= form.label :project_id, "Project", class: "field__label" %>
    <%= form.collection_select :project_id, current_team.projects.alphabetical, :id, :name,
          { include_blank: Project::OTHER }, class: "select", "aria-invalid": task.errors.include?(:project) %>
  </div>

  <div class="field">
    <%= form.label :url, "Link", class: "field__label" %>
    <%= form.url_field :url, class: "input", placeholder: "https://",
          "aria-invalid": task.errors.include?(:url) %>
    <p class="field__hint">The tab, thread or email this is about.</p>
  </div>

  <div class="field">
    <%= form.label :notes, class: "field__label" %>
    <%= form.text_area :notes, class: "textarea" %>
  </div>

  <div class="form-actions">
    <%= form.submit "Save task", class: "btn btn--primary" %>
    <%= link_to "Cancel", dashboard_path, class: "btn btn--ghost" %>
  </div>
<% end %>
