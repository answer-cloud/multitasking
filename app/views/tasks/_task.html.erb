<%# A task still to do. The checkbox is a real submit button inside a real %>
<%# form, so ticking works without JavaScript; checklist#check adds the fun. %>
<%# The rest of the row is a native <details>: click anywhere on it and it %>
<%# opens, like a catalogue entry — no JavaScript there either. The handle %>
<%# drags the row up and down the list; see sortable_controller.js. %>
<li id="<%= dom_id(task) %>" class="checklist__item" data-checklist-item>
  <button type="button" class="checklist__handle" aria-label="Move: <%= task.title %>"
          title="Drag to move, or use the arrow keys"
          data-sortable-target="handle" data-url="<%= task_position_path(task) %>"
          data-action="pointerdown->sortable#grab pointermove->sortable#move pointerup->sortable#drop lostpointercapture->sortable#drop keydown->sortable#nudge">
    <svg viewBox="0 0 10 16" aria-hidden="true" focusable="false">
      <circle cx="2" cy="2" r="1.5" /><circle cx="8" cy="2" r="1.5" />
      <circle cx="2" cy="8" r="1.5" /><circle cx="8" cy="8" r="1.5" />
      <circle cx="2" cy="14" r="1.5" /><circle cx="8" cy="14" r="1.5" />
    </svg>
  </button>
  <%= form_with url: task_completion_path(task), method: :post, class: "checklist__form" do %>
    <button type="submit" class="checkbox" role="checkbox" aria-checked="false"
            aria-label="Done: <%= task.title %>"
            data-action="checklist#check">
      <%= render "tasks/tick" %>
    </button>
  <% end %>

  <details class="checklist__details">
    <summary class="checklist__summary">
      <%= project_badge(task) %>
      <span class="checklist__title"><%= task.title %></span>
      <span class="checklist__from"><%= source_badge(task) %></span>
      <%= task_age(task) %>
    </summary>

    <div class="checklist__panel">
      <% if task.link %>
        <p class="checklist__open"><%= open_link(task) %></p>
      <% end %>

      <% if task.notes.present? %>
        <div class="checklist__notes"><%= simple_format(task.notes) %></div>
      <% end %>

      <%# A task that is already an agent's conversation opens that instead. %>
      <% unless task.app_link? %>
        <div class="checklist__actions">
          <% Task::AGENTS.each do |agent| %>
            <%= hand_off_button(task, agent) %>
          <% end %>
        </div>
      <% end %>

      <dl class="checklist__facts">
        <dt>Project</dt>
        <dd><%= render "tasks/project_picker", task: task, projects: projects %></dd>
        <dt>Added</dt>
        <dd><%= time_ago_in_words(task.created_at) %> ago<%= " by #{task.created_by.name}" if task.created_by %></dd>
        <% if task.last_activity_at > task.created_at + 1.minute %>
          <dt>Last heard</dt>
          <dd><%= time_ago_in_words(task.last_activity_at) %> ago</dd>
        <% end %>
      </dl>

      <%# No policy check: this partial is also broadcast to open dashboards, %>
      <%# where there is no signed-in user to ask, and every member may edit. %>
      <div class="checklist__actions">
        <%= link_to "Edit", edit_task_path(task), class: "btn-link" %>
        <%= button_to "Delete", task, method: :delete, class: "btn-link btn-link--danger",
              form: { data: { turbo_confirm: "Delete this task for good?" } } %>
      </div>
    </div>
  </details>

  <%= render "tasks/priority_toggle", task: task %>
</li>
