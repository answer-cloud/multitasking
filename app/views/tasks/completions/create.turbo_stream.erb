<%# checklist#check holds the remove back until the send-off animation ends. %>
<%= turbo_stream.remove @task %>
<%= turbo_stream.replace "done_today", partial: "tasks/done_today", locals: { tasks: @done_today } %>
<%= turbo_stream.update_all done_count_selector(@task.assignee), @done_today.size.to_s %>
