<%= turbo_stream.replace "done_today", partial: "tasks/done_today", locals: { tasks: @done_today } %>
<%= turbo_stream.prepend task_list_id(@task), partial: "tasks/task", locals: { task: @task, projects: current_team.projects.alphabetical } %>
<%= turbo_stream.update_all "[data-done-count]", current_team.tasks.done_today.count.to_s %>
