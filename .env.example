# Non-secret runtime configuration.
#
# ASCII only, on purpose. foreman, dotenv and shell exporters read this file
# with whatever the ambient locale says, so a smart quote or an em dash here
# crashes `bin/dev` for anyone whose LANG is not a UTF-8 locale.
#
# Copy to .env for development (bin/setup does this for you). Secrets do NOT
# belong here - Stripe keys, the Stripe webhook secret and the Sentry DSN live
# in Rails encrypted credentials. See README.md.
#
# .env is gitignored; this file is not.

# --- Application ------------------------------------------------------------
# Host and scheme used to build absolute URLs in mail and redirects.
APP_HOST=localhost:3000
APP_PROTOCOL=http

# The From: address on outbound mail, and where support replies should go.
MAILER_FROM=noreply@example.com
SUPPORT_EMAIL=support@example.com

# --- Database ---------------------------------------------------------------
# Development and test use local socket auth and only need a database name.
# Production is driven entirely by DATABASE_URL, which Hatchbox provides.
# DATABASE_NAME=multitasking_development
# TEST_DATABASE_NAME=multitasking_test
# DATABASE_URL=postgres://user:password@host:5432/multitasking_production

# --- Redis ------------------------------------------------------------------
# Backs Sidekiq, the production cache store, and Action Cable.
REDIS_URL=redis://localhost:6379/0

# --- Background jobs --------------------------------------------------------
# SIDEKIQ_CONCURRENCY=5

# --- AWS --------------------------------------------------------------------
# Region and bucket only. There are deliberately NO AWS access keys anywhere in
# this application - on EC2 the SDK resolves credentials from the instance IAM
# role, which must allow ses:SendEmail, ses:SendRawEmail, and s3:* on the bucket.
AWS_REGION=us-east-1
S3_BUCKET=

# --- Web server -------------------------------------------------------------
# PORT=3000
# RAILS_MAX_THREADS=5
# WEB_CONCURRENCY=2

# --- Observability ----------------------------------------------------------
# The Sentry DSN normally lives in Rails credentials. Setting it here works too
# and takes second place to credentials - useful for a staging box that should
# report to a different project without re-encrypting anything.
# SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
